# Copy to .env (never commit .env). Same setup as the course labs: Ollama running locally.
MODEL=ollama/qwen3.5:4b
API_BASE=http://localhost:11434

# Optional: a hosted model instead of Ollama
# MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Scenario folder used by `crewai run` (airspace.graphml, aircraft.json, flight_plans.json)
ATC_SCENARIO=data/scenarios/sample_conflict
ATC_OUTPUT=output

CREWAI_TRACING_ENABLED=false
